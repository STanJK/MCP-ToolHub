{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MCP-ToolHub",
  "version": "0.1.0",
  "identifier": "com.stanjk.mcp-toolhub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5174",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MCP-ToolHub",
        "width": 1600,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 720,
        "center": true,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": false }
}
